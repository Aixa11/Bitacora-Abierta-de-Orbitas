{
  "rewrites": [
    {
      "source": "/proxy/celestrak/:path*",
      "destination": "https://celestrak.org/:path*"
    },
    {
      "source": "/proxy/ariss/:path*",
      "destination": "https://live.ariss.org/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
